<?xml version="1.0" encoding="utf-8" ?>
<BaseView x:Class="MauiAppDemo.Wizard.Demo.HeatPumpHeatingPage"
          x:DataType="HeatPumpHeatingViewModel"
          Title="Heat pump: Heating">

    <Grid RowDefinitions="*,Auto" Padding="20" RowSpacing="15">
        <VerticalStackLayout Spacing="15">
            <Label Text="{Binding FlowTemperature, StringFormat='Flow temperature: {0} °C'}" />
            <Stepper Minimum="25" Maximum="60" Increment="1" Value="{Binding FlowTemperature}" />

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding HasUnderfloorHeating}" />
                <Label Text="Underfloor heating (otherwise radiators)" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Text="Cancel" Command="{Binding CancelCommand}" />
            <Button Grid.Column="1" Text="Next" Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</BaseView>
