<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppDemo.AppShell"
    Shell.FlyoutBehavior="Flyout">

    <Shell.ToolbarItems>
        <ToolbarItem Text="ShellItem1" />
        <ToolbarItem Text="ShellItem2" />
    </Shell.ToolbarItems>

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">

        <Tab Title="Home">
            <ShellContent Shell.TabBarIsVisible="False"
                          Title="Home" x:Name="MainPage"
                          ContentTemplate="{DataTemplate MainPage}"
                          Route="MainPage" />
        </Tab>

        <Tab Title="Page1">
            <ShellContent Shell.TabBarIsVisible="False"
                          Title="Page1" x:Name="NewPage1"
                          ContentTemplate="{DataTemplate NewPage1}"
                          Route="NewPage1" />
        </Tab>

    </FlyoutItem>

    <ShellContent
        Title="LayoutTest1" x:Name="LayoutTest1"
        ContentTemplate="{DataTemplate LayoutTest1}"
        Route="LayoutTest1" />

</Shell>
