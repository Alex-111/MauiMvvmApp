<?xml version="1.0" encoding="utf-8" ?>
<views:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppDemo.Views.NewPage2"
              x:DataType="vm:NewPage2ViewModel"
               xmlns:views="clr-namespace:MauiAppDemo.Views"
                xmlns:vm="clr-namespace:MauiAppDemo.ViewModels"
             Title="NewPage2">

  
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button Text="Page2" Command="{Binding OnButtonClick}">
        </Button>

        <Button Text="Home" Command="{Binding OnButton2Click}">
        </Button>

        <Button Text="HomeClearStack" Command="{Binding OnButton3Click}">
        </Button>

        <Button Text="ModalPage3" Command="{Binding Button4Command}">
        </Button>

        <Button Text="ClearStack" Command="{Binding ClearStackCommand}">
        </Button>
    </VerticalStackLayout>
</views:BaseView>