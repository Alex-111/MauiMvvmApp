<?xml version="1.0" encoding="utf-8" ?>
<BaseView x:Class="MauiAppDemo.Views.NewPage2"
          x:DataType="NewPage2ViewModel"
          Title="NewPage2">

    <VerticalStackLayout>
        <Label
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding Count, StringFormat='Page2 depth: {0}'}"
            HorizontalOptions="Center" />

        <Button Text="Page2" Command="{Binding OpenNextPage2Command}" />

        <Button Text="Home" Command="{Binding GoHomeCommand}" />

        <Button Text="HomeClearStack" Command="{Binding GoHomeAndClearStackCommand}" />

        <Button Text="ModalPage3" Command="{Binding OpenModalPage3Command}" />

        <Button Text="ClearStack" Command="{Binding ClearStackCommand}" />
    </VerticalStackLayout>
</BaseView>
