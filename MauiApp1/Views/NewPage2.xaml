<?xml version="1.0" encoding="utf-8" ?>
<views:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.NewPage2"
              
               xmlns:views="clr-namespace:MauiApp1.Views"
                xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             Title="NewPage2">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button Text="Page2" Command="{Binding OnButtonClick}">
        </Button>

        <Button Text="Home" Command="{Binding OnButton2Click}">
        </Button>

        <Button Text="HomeClearStack" Command="{Binding OnButton3Click}">
        </Button>
    </VerticalStackLayout>
</views:BaseView>